# Local preview of the website. GitHub Pages builds the site with this same
# gem version (see .github/workflows/site.yml).
#
#   bundle install
#   bundle exec jekyll serve
#
# Then open http://localhost:4000/mission/
source "https://rubygems.org"

# github-pages 232 does not install on Ruby 4. GitHub builds with Ruby 3.3.
ruby ">= 3.1", "< 4.0"

gem "github-pages", "232", group: :jekyll_plugins
